;; gf/modes/router.prn -- the engine's mod surface, routed to one mode.
;;
;; The unified build (gf/gf.modules) links the engine once and every mode beside it. PARENA has no dynamic dispatch, so the
;; engine's 14 mod-* hooks are defined here, once, and each one picks its implementation from the global g-gf-mode
;; (0 arena, 1 survival, 2 playground, 3 queue, 4 construct). SURVIVAL (sv-mod-* in gf/modes/survival/sv_mod.prn) and
;; CONSTRUCT (cg-mod-* in gf/modes/construct/construct.prn) have implementations; every other id -- and every mode that
;; has none -- gets the arena's no-op answer, which is the same contract sp_mods.prn gives the parity build
;; (gf/arena.modules).
;;
;; Switching is an explicit call, not a per-frame decision: gf-mode-set (exported for the host and for the menu, G3) sets the
;; word, clears the session and loads the new mode's level, and leaves the game on the title screen. Each mode's own
;; *-mod-active? also checks the engine's g-mode, so a mode left behind cannot tick in the next one.
;;
;; The signatures here must keep matching sp_mods.prn (the contract, with every call site named there).

(defn g-gf-mode [] : I32 640)   ; G 640: 0 arena, 1 survival, 2 playground, 3 queue, 4 construct (plan §9)
(defn gf-mode [] : I32 (gi (g-gf-mode)))

;; the host, the menu and the tests switch modes through this; it is a reset to that mode's title screen.
(defn gf-mode-set [(m : I32)] : Unit
  (let [m (clamp-i m 0 4)]
    (do
      (gi! (g-gf-mode) m)
      (gi! (g-phase) 0)
      (gi! (g-ui-t) 0)
      (gi! (g-paused) 0)
      (gi! (g-want-queue) 0)
      (gi! (g-q-state) 0)
      (clear-world!)
      (cond
        (= m 1) (sv-mod-init!)
        (= m 4) (cg-mod-init!)
        :else (do (gi! (g-map-id) 0) (init-map!) (gi! (g-mode) 0))))))

;; the routed modes in the build today
(defn gf-survival? [] : Bool (= (gi (g-gf-mode)) 1))
(defn gf-construct? [] : Bool (= (gi (g-gf-mode)) 4))

;; ---- the 14 hooks (contract: gf/engine/sp_mods.prn) ---------------------------------------------------------------
(defn mod-init! [] : Unit (cond (gf-survival?) (sv-mod-init!) (gf-construct?) (cg-mod-init!) :else unit))
(defn mod-active? [] : Bool (cond (gf-survival?) (sv-mod-active?) (gf-construct?) (cg-mod-active?) :else false))
(defn mod-begin! [] : Bool (cond (gf-survival?) (sv-mod-begin!) (gf-construct?) (cg-mod-begin!) :else false))
(defn mod-tick! [] : Unit (cond (gf-survival?) (sv-mod-tick!) (gf-construct?) (cg-mod-tick!) :else unit))
(defn mod-bot-think! [(p : I32)] : Bool (if (gf-survival?) (sv-mod-bot-think! p) false))
(defn mod-respawn? [(p : I32)] : Bool (if (gf-survival?) (sv-mod-respawn? p) true))
(defn mod-weapon-ok? [(p : I32) (w : I32)] : Bool (if (gf-survival?) (sv-mod-weapon-ok? p w) true))
(defn mod-bounds [] : F32 (cond (gf-survival?) (sv-mod-bounds) (gf-construct?) (cg-mod-bounds) :else 420.0))
(defn mod-hitscan! [(p : I32) (ox : F32) (oy : F32) (oz : F32) (dx : F32) (dy : F32) (dz : F32)] : Unit
  (when (gf-survival?) (sv-mod-hitscan! p ox oy oz dx dy dz)))
(defn mod-box-color [(i : I32)] : I32 (cond (gf-survival?) (sv-mod-box-color i) (gf-construct?) (cg-mod-box-color i) :else -1))
(defn mod-draw-world! [] : Unit (cond (gf-survival?) (sv-mod-draw-world!) (gf-construct?) (cg-mod-draw-world!) :else unit))
(defn mod-hud! [(me : I32)] : Unit (cond (gf-survival?) (sv-mod-hud! me) (gf-construct?) (cg-mod-hud! me) :else unit))
(defn mod-title! [] : Bool (if (gf-survival?) (sv-mod-title!) false))
(defn mod-end! [(alpha : F32)] : Bool (if (gf-survival?) (sv-mod-end! alpha) false))
