;; gf/modes/router.prn -- the engine's mod surface, routed to one mode.
;;
;; The unified build (gf/gf.modules) links the engine once and every mode beside it. PARENA has no dynamic dispatch, so the
;; engine's 14 mod-* hooks are defined here, once, and each one selects the implementation for the current mode. The arena
;; has no implementation (the hooks do nothing); SURVIVAL's are sv-mod-* in gf/modes/survival/sv_mod.prn.
;;
;; G1 is the manifest and this pass-through: SURVIVAL is the only mode in the build. G2 adds the mode global and the switch,
;; with the arena as the default; the signatures here must keep matching sp_mods.prn (the contract).

(defn mod-init! [] : Unit (sv-mod-init!))
(defn mod-active? [] : Bool (sv-mod-active?))
(defn mod-begin! [] : Bool (sv-mod-begin!))
(defn mod-tick! [] : Unit (sv-mod-tick!))
(defn mod-bot-think! [(p : I32)] : Bool (sv-mod-bot-think! p))
(defn mod-respawn? [(p : I32)] : Bool (sv-mod-respawn? p))
(defn mod-weapon-ok? [(p : I32) (w : I32)] : Bool (sv-mod-weapon-ok? p w))
(defn mod-bounds [] : F32 (sv-mod-bounds))
(defn mod-hitscan! [(p : I32) (ox : F32) (oy : F32) (oz : F32) (dx : F32) (dy : F32) (dz : F32)] : Unit
  (sv-mod-hitscan! p ox oy oz dx dy dz))
(defn mod-box-color [(i : I32)] : I32 (sv-mod-box-color i))
(defn mod-draw-world! [] : Unit (sv-mod-draw-world!))
(defn mod-hud! [(me : I32)] : Unit (sv-mod-hud! me))
(defn mod-title! [] : Bool (sv-mod-title!))
(defn mod-end! [(alpha : F32)] : Bool (sv-mod-end! alpha))
